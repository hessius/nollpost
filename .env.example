# Nollpost requires NO API keys or cloud credentials.
# All variables below are optional path overrides.

# NOLLPOST_CONFIG=~/.config/nollpost/config.toml
# NOLLPOST_DATA_DIR=~/Library/Application Support/nollpost
# NOLLPOST_CACHE_DIR=~/Library/Caches/nollpost
# NOLLPOST_LOCK_PATH=~/Library/Application Support/nollpost/mail_automation.lock
